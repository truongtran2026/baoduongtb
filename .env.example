# Copy the variables you need into your Vercel project's Environment
# Variables settings (Project -> Settings -> Environment Variables).
# Nothing here is read from a real .env file on Vercel itself - this is just
# a reference for what to set. Not needed at all for the local/LAN run.bat
# deployment, which uses a local SQLite file with no login required.

# Postgres connection string. If you use Vercel's own Postgres/Neon
# integration, it injects POSTGRES_URL automatically and you can skip this.
# Otherwise set it to any standard Postgres connection string.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Signs the login session cookie. Set this explicitly in production so a
# redeploy doesn't invalidate everyone's session - generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-to-a-random-64-char-hex-string

# Creates the first login on the very first startup (only runs once, when
# the users table is empty). Change the password after logging in by
# creating a new deployment-time value isn't supported yet - for now, reuse
# this bootstrap by clearing the users table if you need to reset it.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
